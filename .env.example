# Copy to .env and fill in what you have. Nothing here is required to run the
# demo — with no key set, the parser falls back to local Ollama (llama3.2).

# Optional: enables the Claude API parser instead of Ollama.
# This is API billing, separate from a claude.ai / Claude Pro subscription.
ANTHROPIC_API_KEY=

# Which provider to use for the LLM parse step: "auto" (default) picks Claude if
# ANTHROPIC_API_KEY is set, else Ollama. Force one with "claude" or "ollama".
PROTEIN_LLM=auto

# Models per provider.
CLAUDE_MODEL=claude-opus-4-8
OLLAMA_MODEL=llama3.2

# Daily protein goal in grams (the thing we track against).
PROTEIN_GOAL_G=70

# Docker & Ollama configuration
# Ollama endpoint. Leave empty for native runs — defaults to http://localhost:11434.
# In Docker, compose supplies http://host.docker.internal:11434 automatically.
OLLAMA_HOST=

# LLM timeout in seconds for API calls (default 60s).
PROTEIN_LLM_TIMEOUT_S=60

# Total attempts per LLM call (2 = one retry after the first failure).
PROTEIN_LLM_RETRIES=2

# Fuzzy string matching threshold (0-100); values 80+ recommended for precision.
PROTEIN_MATCHER=fuzzy
PROTEIN_FUZZY_THRESHOLD=80
